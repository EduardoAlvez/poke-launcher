{
  "name": "poke-launcher",
  "version": "0.2.5",
  "description": "Launcher multi-sessao para jogos idle online (pokeidle.io) com sessoes isoladas, bandeja e addons por jogo.",
  "author": "EduardoAlvez",
  "homepage": "https://github.com/EduardoAlvez/poke-launcher",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.pokelauncher.app",
    "productName": "Poke Launcher",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon-256.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon-256.png",
      "target": [
        "deb"
      ],
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EduardoAlvez",
        "repo": "poke-launcher",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "extract-zip": "^2.0.1"
  }
}
